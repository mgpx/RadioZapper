<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RadioZapper.Views.RadioDetailsWindow"
        x:CompileBindings="False"
        Width="620" Height="680" MinWidth="450" MinHeight="450"
        WindowStartupLocation="CenterOwner" Title="Mais detalhes — Radio Zapper">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="14">
      <TextBlock Text="{Binding StationName}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" />
      <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
      <Border CornerRadius="12" Padding="14" Background="#16808080">
        <StackPanel Spacing="5">
          <TextBlock Text="Programação prevista agora" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CurrentPrograms}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <TextBlock Text="Sobre a rádio" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Segments, StringFormat='Segmentos: {0}'}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Contacts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Grade semanal" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
      <ItemsControl ItemsSource="{Binding Days}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="6" Margin="0,0,0,14">
              <TextBlock Text="{Binding Day}" FontSize="15" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Programs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="10" Margin="0,2">
                      <TextBlock Text="{Binding Time}" Opacity="0.7" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Os horários são previstos pelo catálogo e podem diferir do áudio transmitido."
                 FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Window>
