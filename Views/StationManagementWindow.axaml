<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RadioZapper.Views.StationManagementWindow"
        x:CompileBindings="False"
        Width="610" Height="650" MinWidth="480" MinHeight="450"
        WindowStartupLocation="CenterOwner" Title="Minhas rádios — Radio Zapper">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Minhas rádios" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Organize a ordem usada pelos botões anterior e próximo."
                   FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Content="+ Adicionar rádio" Command="{Binding AddCommand}" Padding="14,10" />
    </Grid>

    <Grid Grid.Row="1">
      <TextBlock Text="Nenhuma rádio cadastrada. Adicione uma para começar."
                 IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextWrapping="Wrap" Opacity="0.65" />
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Stations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="12" Background="#12808080" Padding="12" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                  <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Command="{Binding SelectCommand}" Background="Transparent" BorderThickness="0">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Location}" FontSize="11" Opacity="0.65" />
                      <TextBlock Text="Selecionada" IsVisible="{Binding IsCurrent}" FontSize="10" Opacity="0.65" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Row="0" Grid.Column="1" Content="{Binding FavoriteGlyph}" FontSize="20"
                          Command="{Binding FavoriteCommand}" ToolTip.Tip="Favoritar" />
                  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="5"
                              HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Content="▶ Tocar" Command="{Binding PlayCommand}" FontSize="11" />
                    <Button Content="↑" Command="{Binding MoveUpCommand}" ToolTip.Tip="Mover para cima" FontSize="11" />
                    <Button Content="↓" Command="{Binding MoveDownCommand}" ToolTip.Tip="Mover para baixo" FontSize="11" />
                    <Button Content="Editar" Command="{Binding EditCommand}" FontSize="11" />
                    <Button Content="Excluir" Command="{Binding DeleteCommand}" FontSize="11" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
  </Grid>
</Window>
