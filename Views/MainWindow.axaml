<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RadioZapper.Views.MainWindow"
        x:CompileBindings="False"
        Width="400" Height="520" MinWidth="360" MinHeight="500"
        Title="Radio Zapper" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="20" RowSpacing="12">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="RADIO ZAPPER" FontSize="19" FontWeight="Bold" />
        <TextBlock Text="Suas rádios, em um toque" Opacity="0.65" FontSize="12" />
      </StackPanel>
      <Button Grid.Column="1" Content="⚙" FontSize="18" Command="{Binding SettingsCommand}" ToolTip.Tip="Configurações" />
    </Grid>

    <Border Grid.Row="1" CornerRadius="22" Padding="18" Background="#19808080" MinHeight="190">
      <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="82" Height="82" CornerRadius="18" Background="#33808080" HorizontalAlignment="Center">
          <Grid>
            <Image Source="{Binding CurrentLogo}" Stretch="UniformToFill" />
            <TextBlock Text="♫" IsVisible="{Binding IsLogoMissing}" FontSize="42"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <TextBlock Text="{Binding CurrentName}" FontSize="21" FontWeight="SemiBold"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
        <TextBlock Text="{Binding CurrentLocation}" Opacity="0.65" FontSize="12" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Status}" FontSize="12" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
      <Button Width="60" Height="54" Command="{Binding PreviousCommand}" ToolTip.Tip="Estação anterior">
        <PathIcon Width="25" Height="25" Data="M4,5 L6,5 L6,19 L4,19 Z M20,5 L20,19 L8,12 Z" />
      </Button>
      <Button Width="70" Height="60" Command="{Binding ToggleCommand}" ToolTip.Tip="Reproduzir ou pausar">
        <Grid Width="28" Height="28">
          <PathIcon Width="27" Height="27" IsVisible="{Binding ShowPlayIcon}" Data="M7,4 L21,12 L7,20 Z" />
          <PathIcon Width="27" Height="27" IsVisible="{Binding ShowPauseIcon}" Data="M5,4 L10,4 L10,20 L5,20 Z M14,4 L19,4 L19,20 L14,20 Z" />
        </Grid>
      </Button>
      <Button Width="60" Height="54" Command="{Binding NextCommand}" ToolTip.Tip="Próxima estação">
        <PathIcon Width="25" Height="25" Data="M18,5 L20,5 L20,19 L18,19 Z M4,5 L16,12 L4,19 Z" />
      </Button>
    </StackPanel>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
      <TextBlock Text="Volume" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume}" TickFrequency="5" />
    </Grid>

    <Button Grid.Row="4" Content="Salvar rádio" Command="{Binding SaveCurrentCommand}"
            IsVisible="{Binding CanSaveCurrent}" HorizontalAlignment="Stretch" />
    <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
    <Grid Grid.Row="6" ColumnDefinitions="*,*" ColumnSpacing="8">
      <Button Content="Buscar rádios" Command="{Binding SearchCommand}" HorizontalAlignment="Stretch" Padding="12,10" />
      <Button Grid.Column="1" Content="Minhas rádios" Command="{Binding StationsCommand}"
              HorizontalAlignment="Stretch" Padding="12,10" />
    </Grid>
  </Grid>
</Window>
